# Local development
HOST=127.0.0.1
PORT=4178
SFF_DATA=./sff-data
SFF_HTTPS=0
SFF_PUBLIC_HOST=

# Production database (Turso)
# Kada su oba polja postavljena, backend automatski koristi Turso umesto lokalnog SQLite fajla.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email verification / password reset (Resend)
# Production treba da koristi SFF_REQUIRE_VERIFIED_EMAIL=1.
SFF_REQUIRE_VERIFIED_EMAIL=0
RESEND_API_KEY=
SFF_MAIL_FROM=

# WebRTC RTCIceServer JSON array. Za stabilan voice/video preko raznih mreža dodaj TURN.
SFF_ICE=[]
